# ─── SOLANA ───────────────────────────────────────────────
# Helius (empfohlen): https://helius.xyz
# QuickNode geht auch
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=DEIN_KEY
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=DEIN_KEY

# Dein Solana Private Key (Base58)
SOLANA_PRIVATE_KEY=DEIN_SOLANA_PRIVATE_KEY_BASE58

# Wallet die du kopieren willst (z.B. Cented's Wallet)
TARGET_WALLET_SOL=ZIEL_WALLET_ADRESSE_HIER

# ─── ETHEREUM ────────────────────────────────────────────
# Alchemy (empfohlen): https://alchemy.com
# Infura geht auch
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/DEIN_KEY
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/DEIN_KEY

# Dein ETH Private Key (0x...)
ETH_PRIVATE_KEY=0xDEIN_ETH_PRIVATE_KEY

# Wallet die du kopieren willst
TARGET_WALLET_ETH=0xZIEL_WALLET_ADRESSE_HIER

# ─── FILTER ──────────────────────────────────────────────
# Maximale Trade-Größe (in SOL) — Trades darüber werden auf diesen Wert gekappt
MAX_TRADE_SOL=1.0

# Maximale Trade-Größe (in ETH) — Trades darüber werden auf diesen Wert gekappt
MAX_TRADE_ETH=0.05

# Slippage in Basispunkten (50 = 0.5%)
SLIPPAGE_BPS=50

# ─── TRADING FLAGS ───────────────────────────────────────
# Solana Copy-Trading aktivieren (true/false)
ENABLE_SOL=true

# Ethereum Copy-Trading aktivieren (true/false)
ENABLE_ETH=true

# Trockenlauf: Trades werden analysiert aber NICHT ausgeführt
DRY_RUN=true
