# Kopiere diese Datei zu .env und fülle die Werte aus

# Meta Webhook Verification Token (selbst ausdenken, dann in Meta eintragen)
META_VERIFY_TOKEN=vodafone_d2d_token

# Meta App Secret (aus Meta Developer Console)
META_APP_SECRET=

# Admin Passwort für das Dashboard
ADMIN_TOKEN=changeme123

# Port
PORT=5000

# ── E-Mail Benachrichtigung ───────────────────────────────────
# SMTP Server (Gmail Beispiel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Deine Gmail-Adresse (von der gesendet wird)
SMTP_USER=deine@gmail.com

# Gmail App-Passwort (nicht dein normales Passwort!)
# Erstellen unter: myaccount.google.com → Sicherheit → App-Passwörter
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Wohin soll die Benachrichtigung gehen? (deine E-Mail)
NOTIFY_EMAIL=deine@gmail.com
